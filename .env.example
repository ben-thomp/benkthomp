# Copy this file to .env for local development (never commit .env)

# Generate with: python -c "import hashlib; print(hashlib.sha256(b'yourpassword').hexdigest())"
ROADMAP_ADMIN_KEY=

SECRET_KEY=dev-secret-key-change-in-production
FLASK_DEBUG=true

# Enclosure readings (SQLite file; put it on a persistent disk in production)
ENCLOSURE_DB_PATH=instance/enclosures.db
# Bearer token the Pi/n8n must send to POST /api/readings. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCLOSURE_INGEST_TOKEN=

# Dev only: read each project's ROADMAP.md from sibling folders instead of GitHub
# PROJECT_ROADMAP_LOCAL_DIR=C:/path/to/Repos
